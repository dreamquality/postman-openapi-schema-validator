{
  "info": {
    "name": "OpenAPI 3.1 Test Collection",
    "description": "Test collection for OpenAPI 3.1 validation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List Pets",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pets?limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pets"
          ],
          "query": [
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "        const Ajv = require('ajv');",
              "        const ajv = new Ajv({ allErrors: true });",
              "",
              "        ajv.addFormat('int32', {",
              "            type: 'number',",
              "            validate: (x) => Number.isInteger(x) && x >= -(2**31) && x <= 2**31 - 1,",
              "        });",
              "",
              "        const schema = {\"type\":\"object\",\"properties\":{\"pets\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"id\",\"name\"],\"properties\":{\"id\":{\"type\":\"integer\",\"format\":\"int64\"},\"name\":{\"type\":\"string\"},\"tag\":{\"type\":[\"string\",\"null\"],\"description\":\"OpenAPI 3.1 nullable syntax - can be string or null\"},\"status\":{\"type\":\"string\",\"enum\":[\"available\",\"pending\",\"sold\"],\"default\":\"available\"},\"weight\":{\"type\":\"number\",\"exclusiveMinimum\":0,\"description\":\"OpenAPI 3.1 boolean exclusiveMinimum\"}}}},\"total\":{\"type\":\"integer\",\"description\":\"Total number of pets\"}},\"required\":[\"pets\"]};",
              "        const validate = ajv.compile(schema);",
              "        const data = pm.response.json();",
              "        const valid = validate(data);",
              "",
              "        pm.test(\"Response schema is valid\", function() {",
              "            if (!valid) {",
              "                console.log('Schema validation errors:', validate.errors);",
              "            }",
              "            pm.expect(valid, \"Schema errors: \" + JSON.stringify(validate.errors, null, 2)).to.be.true;",
              "        });",
              "    "
            ]
          }
        }
      ]
    },
    {
      "name": "Create Pet",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Fluffy\",\n  \"tag\": \"cat\",\n  \"status\": \"available\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/pets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pets"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "        const Ajv = require('ajv');",
              "        const ajv = new Ajv({ allErrors: true });",
              "",
              "        ajv.addFormat('int32', {",
              "            type: 'number',",
              "            validate: (x) => Number.isInteger(x) && x >= -(2**31) && x <= 2**31 - 1,",
              "        });",
              "",
              "        const schema = {\"type\":\"object\",\"required\":[\"id\",\"name\"],\"properties\":{\"id\":{\"type\":\"integer\",\"format\":\"int64\"},\"name\":{\"type\":\"string\"},\"tag\":{\"type\":[\"string\",\"null\"],\"description\":\"OpenAPI 3.1 nullable syntax - can be string or null\"},\"status\":{\"type\":\"string\",\"enum\":[\"available\",\"pending\",\"sold\"],\"default\":\"available\"},\"weight\":{\"type\":\"number\",\"exclusiveMinimum\":0,\"description\":\"OpenAPI 3.1 boolean exclusiveMinimum\"}}};",
              "        const validate = ajv.compile(schema);",
              "        const data = pm.response.json();",
              "        const valid = validate(data);",
              "",
              "        pm.test(\"Response schema is valid\", function() {",
              "            if (!valid) {",
              "                console.log('Schema validation errors:', validate.errors);",
              "            }",
              "            pm.expect(valid, \"Schema errors: \" + JSON.stringify(validate.errors, null, 2)).to.be.true;",
              "        });",
              "    "
            ]
          }
        }
      ]
    },
